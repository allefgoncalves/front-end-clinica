# .env.example
# Copie este arquivo para .env e preencha com suas configurações locais

# API
VITE_API_URL=http://127.0.0.1:8001/api
VITE_API_TIMEOUT=30000

# Autenticação
VITE_TOKEN_KEY=access_token
VITE_REFRESH_TOKEN_KEY=refresh_token
VITE_USER_KEY=user

# Aplicação
VITE_APP_NAME="Sistema Clínica de Massagem"
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=development

# Features
VITE_ENABLE_WHATSAPP=false
VITE_ENABLE_NOTIFICATIONS=true
VITE_DEFAULT_THEME=light

# Paginação
VITE_DEFAULT_PAGE_SIZE=20
VITE_MAX_PAGE_SIZE=100

# Alertas
VITE_LOW_STOCK_THRESHOLD=5
VITE_EXPIRY_WARNING_DAYS=30

# Horário Comercial
VITE_BUSINESS_HOURS_START=8
VITE_BUSINESS_HOURS_END=20
VITE_MIN_ADVANCE_HOURS=2

# Uploads
VITE_MAX_IMAGE_SIZE=5242880
VITE_ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp

# Contato
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=

# Debug
VITE_DEBUG_MODE=true
VITE_LOG_LEVEL=debug